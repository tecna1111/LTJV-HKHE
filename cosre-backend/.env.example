# Copy file nay thanh ".env" (cung thu muc voi docker-compose.mysql.yml) roi chinh lai gia tri
# neu can. KHONG commit file ".env" that len git (chi commit ".env.example" nay).

# ===== Dung cho docker-compose.mysql.yml =====
MYSQL_ROOT_PASSWORD=root
DB_NAME=cosre
DB_USERNAME=cosre_app
DB_PASSWORD=CosreApp@123
DB_PORT=3306

# ===== Dung khi chay Spring Boot voi -Dspring.profiles.active=mysql =====
DB_URL=jdbc:mysql://localhost:3306/cosre?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
JWT_SECRET=change-this-to-a-random-32-plus-character-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Bat tai khoan he thong mac dinh (Admin/HeadDept/Staff/Lecturer/2 Student demo)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_USERS_ENABLED=true

# Chi bat 1 LAN de seed du lieu hoc vu demo (Subject SE101 + Syllabus + Classroom) tren MySQL dung chung.
# Sau khi da co du lieu that, doi lai thanh false de tranh nham lan.
BOOTSTRAP_DEMO_ACADEMIC_ENABLED=false

# Gemini AI (tuy chon, de trong neu chua co key)
GEMINI_API_KEY=
